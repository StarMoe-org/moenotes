{
  "name": "moenotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:fresh": "node scripts/clean-dev-cache.mjs && astro dev --force",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "start": "bun server/main.ts",
    "check": "astro check",
    "check:search-seo": "bun run scripts/check-search-seo.ts",
    "lint": "bun run lint:i18n && bun run lint:i18n-routing && bun run lint:routes && bun run lint:arch && bun run lint:text && bun run lint:emoji",
    "lint:i18n": "node scripts/check-i18n-keys.mjs",
    "lint:i18n-routing": "node scripts/check-i18n-routing.mjs",
    "lint:routes": "node scripts/check-route-registry.mjs",
    "lint:arch": "node scripts/check-architecture.mjs",
    "lint:text": "node scripts/scan-hardcoded-ui-text.mjs",
    "lint:emoji": "node scripts/scan-emoji.mjs",
    "fonts:nowar": "python scripts/subset-nowar-font.py",
    "fonts:inspect": "python scripts/subset-nowar-font.py --inspect",
    "sync:chart-renderer": "node scripts/sync-chart-renderer.mjs",
    "release": "bun scripts/release.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "7.3.5",
    "framer-motion": "^12.40.0",
    "ournotes-player": "0.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "6.2.5",
    "git-cliff": "2.14.2",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "ournotes-player@0.1.6": "patches/ournotes-player@0.1.6.patch"
  }
}
