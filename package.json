{
  "name": "moenotes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:fresh": "node scripts/clean-dev-cache.mjs && next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "preview": "next start --hostname 0.0.0.0 --port 3000",
    "start": "cd server && go run ./cmd/moenotes serve",
    "check": "next typegen && tsc --noEmit",
    "check:search-seo": "bun run scripts/check-search-seo.ts",
    "lint": "bun run lint:i18n && bun run lint:i18n-routing && bun run lint:routes && bun run lint:arch && bun run lint:text && bun run lint:emoji && bun run lint:server-config",
    "lint:i18n": "node scripts/check-i18n-keys.mjs",
    "lint:i18n-routing": "node scripts/check-i18n-routing.mjs",
    "lint:routes": "node scripts/check-route-registry.mjs",
    "lint:arch": "node scripts/check-architecture.mjs",
    "lint:text": "node scripts/scan-hardcoded-ui-text.mjs",
    "lint:emoji": "node scripts/scan-emoji.mjs",
    "fonts:nowar": "python scripts/subset-nowar-font.py",
    "fonts:inspect": "python scripts/subset-nowar-font.py --inspect",
    "sync:chart-renderer": "node scripts/sync-chart-renderer.mjs",
    "release": "bun scripts/release.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "lint:server-config": "bun scripts/generate-runtime-config.ts --check",
    "gen:server-config": "bun scripts/generate-runtime-config.ts",
    "build:haneoka-engine": "bun scripts/build-haneoka-engine.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material/material-color-utilities": "0.4.0",
    "@mui/material": "9.4.0",
    "@tailwindcss/postcss": "4.1.18",
    "next": "16.4.3",
    "ournotes-player": "0.1.8",
    "pinyin-pro": "3.29.4",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "6.2.5",
    "git-cliff": "2.14.2",
    "typescript": "^5.9.3"
  }
}
