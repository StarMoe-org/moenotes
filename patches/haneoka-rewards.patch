+                    if probability!=10000.0 {return Err("combined-item-lottery".into());}
+                    let bonus=(self.max_bonus[1]+10000.0) as i128;
+                    self.monotone[1] &= count>=0 && item_rate>=0 && (0..=i32::MAX as i128).contains(&bonus) && (0..=i64::MAX as i128).contains(&(count as i128*bonus*item_rate));
+                }
+            }
+            for (kind, &used) in self.used.iter().enumerate() { if used { Self::whole(self.reward(kind,self.max_bonus[kind.min(1)],rank))?; } }
+        }
+        Ok(())
+    }
+    fn global_range(&self) -> Result<([i128;3],[i128;3]),String> {
+        let mut low=[i128::MAX;3];let mut high=[0;3];
+        for &(rank,_) in &self.eligible {
+            for ((kind, &used), (low_cell, high_cell)) in self.used.iter().enumerate().zip(low.iter_mut().zip(&mut high)) {
+                if !used { continue; }
+                if kind<2 && !self.monotone[kind] {*low_cell=-214748;*high_cell=214748;} else {
+                    *low_cell=(*low_cell).min(Self::whole(self.reward(kind,0.0,rank))?);
+                    *high_cell=(*high_cell).max(Self::whole(self.reward(kind,self.max_bonus[kind.min(1)],rank))?);
+                }
+            }
+        }
+        for (&used, low_cell) in self.used.iter().zip(&mut low) { if !used {*low_cell=0;} }
+        Ok((low,high))
+    }
+    fn sum(&self, level: &[RewardTerm], values: &[i128;3]) -> i128 {
+        level.iter().map(|t|values[t.kind]*t.weight).sum()
+    }
+    fn team_bonus(&self,team:&Team,kind:usize)->f64 {
+        team.members.iter().map(|&m|self.members[kind][m]).sum::<f64>()
+            + team.snaps.iter().filter(|&&s|s>=0).map(|&s|self.snaps[kind][s as usize]).sum::<f64>()
+    }
+}
+impl Objective for LexRewards {
+    fn member_snapshot_prices(&self) -> bool { self.snaps.iter().flatten().any(|&bonus|bonus!=0.0) }
+    fn prepare_power(&mut self, snapshots: Arc<Vec<f64>>, width: usize) {
+        if let Some(bounds)=&mut self.score_bounds {bounds.prepare_power(snapshots,width);}
+    }
+    fn prepare_assignment_power(&mut self, power: f64) {
+        if let Some(bounds)=&mut self.score_bounds {bounds.prepare_assignment_power(power);}
+    }
+    fn accepts_exact(&self, exact:&Exact)->bool {exact.detail["prefixValid"]==true}
+    fn prefer_member(&self, member: usize) -> f64 { self.members[self.selected][member] }
+    fn prefer_snap(&self, _member: usize, snap: i32) -> f64 {
+        if snap < 0 { 0.0 } else { self.snaps[self.selected][snap as usize] }
+    }
+    fn score_ties(&self)->bool { !self.constant }
+    fn physical_teams(&self)->bool { true }
+    fn compare_ties(&self,a:&crate::search::Hit,b:&crate::search::Hit)->std::cmp::Ordering {
+        compare_reward_keys(&a.detail["lexVector"],&b.detail["lexVector"])
+    }
+    fn preserve_snap_options(&self)->bool { true }
+    fn needs_power_cap(&self)->bool { self.core.as_ref().is_some_and(|c|!c.unbounded && c.input.judgements.is_none()) }
+    fn prepare_dominance(&mut self,power:f64) { if let Some(c)=&mut self.core {c.prepare_dominance(power);} }
+    fn skill(&mut self,m:usize,s:i32)->(f64,f64) { self.core.as_mut().map_or((0.0,0.0),|c|{let w=c.weight(m,s);(w.low.worst,w.high.best)}) }
+    fn member_bonus(&self,m:usize)->f64 { self.members[self.selected][m] }
+    fn snap_bonus(&self,s:usize)->f64 { self.snaps[self.selected][s] }
+    fn observe_frontier(&mut self, hits: &[crate::search::Hit], k: usize) {
+        if hits.len() >= k {
+            self.frontier = Some(crate::master::rows(&hits[k-1].detail["lexVector"]).iter()
+                .map(|v|v.as_str().unwrap().parse().unwrap()).collect());
+        }
+    }
+    fn prepare_assignment(&mut self, members: &[usize], options: &[Vec<i32>]) {
+        self.options=options.to_vec();
+        if let Some(bounds)=&mut self.score_bounds {bounds.prepare_assignment(members,options);}
+    }
+    fn prepare_members(&mut self, characters: &[Vec<usize>]) {
+        if let Some(bounds)=&mut self.score_bounds {bounds.prepare_members(characters);}
+        self.member_suffix=std::array::from_fn(|kind|crate::search::suffix_tops(&characters.iter()
+            .map(|group|group.iter().map(|&m|self.members[kind][m]).fold(0.0,f64::max)).collect::<Vec<_>>()));
+    }
+    fn early_member_bound(&mut self, members: &[usize], from: usize, _limit: f64) -> Option<f64> {
+        Some(self.projected_bound(f64::INFINITY, self.member_bonuses(members, 5-members.len(), from)))
+    }
+    fn member_bound_at(&mut self, members: &[usize], t: Totals, left: usize, from: usize, _limit: f64) -> Option<f64> {
+        let high = self.core.as_ref().map_or(f64::INFINITY, |c|c.score_high(t));
+        let mut bonuses = self.member_bonuses(members, left, from);
+        bonuses[self.selected] = bonuses[self.selected].min(t.bonus);
+        let plain=self.projected_bound(high,bonuses);
+        if !plain.is_finite() {return Some(plain);}
+        let bounds=self.score_bounds.as_mut()?;
+        if bounds.core.as_ref()?.unbounded || bounds.core.as_ref()?.input.judgements.is_some() {return Some(plain);}
+        let ids=std::array::from_fn(|slot|if slot<members.len() {bounds.global_profile(members[slot])} else {bounds.suffix_profiles[from]});
+        let coefficients=bounds.order_coefficients(ids);
+        let scores:Vec<_>=coefficients.iter().map(|coefficient|t.power*coefficient).collect();
+        Some(plain.min(self.orders_bound(&scores,bonuses)))
+    }
+    fn cheap_assignment_bound(&mut self, members: &[usize], t: Totals, assigned: &[i32], from: usize) -> f64 {
+        let high = self.core.as_ref().map_or(f64::INFINITY, |c|c.score_high(t));
+        let mut bonuses = self.assignment_bonuses(members, assigned, from, false);
+        bonuses[self.selected] = bonuses[self.selected].min(t.bonus);
+        self.projected_bound(high, bonuses)
+    }
+    fn assignment_bound(&mut self, members: &[usize], t: Totals, assigned: &[i32], from: usize) -> Option<f64> {
+        let high = self.core.as_ref().map_or(f64::INFINITY, |c|c.score_high(t));
+        let mut bonuses = self.assignment_bonuses(members, assigned, from, true);
+        bonuses[self.selected] = bonuses[self.selected].min(t.bonus);
+        Some(self.projected_bound(high, bonuses))
+    }
+    fn assignment_order_bound(&mut self, members: &[usize], t: Totals, assigned: &[i32], from: usize, _limit: f64) -> Option<f64> {
+        let mut bonuses=self.assignment_bonuses(members,assigned,from,false);
+        bonuses[self.selected]=bonuses[self.selected].min(t.bonus);
+        let scores=self.score_bounds.as_mut()?.score_upper_orders(members,assigned,from,t.power)?;
+        let plain=self.orders_bound(&scores,bonuses);
+        if !plain.is_finite() {return Some(plain);}
+        let paired=self.score_bounds.as_mut()?.paired_scores(members,assigned,from,t)?.0;
+        Some(plain.min(self.orders_bound(&paired,bonuses)))
+    }
+    fn leaf_bound(&mut self, team: &Team, t: Totals) -> Option<f64> {
+        let scores=self.score_bounds.as_mut()?.score_upper_orders(&team.members,&team.snaps,5,t.power)?;
+        Some(self.orders_bound(&scores,[self.team_bonus(team,0),self.team_bonus(team,1)]))
+    }
+    fn product_base(&self) -> Option<f64> {
+        self.core.as_ref().filter(|core|!core.unbounded && core.input.judgements.is_none()).map(|core|core.high.total)
+    }
+    fn joint_targets(&mut self, _limit: f64) -> Option<Vec<JointTarget>> {
+        let core=self.core.as_ref().filter(|core|!core.unbounded && core.input.judgements.is_none())?;
+        let frontier=self.frontier.as_ref()?;
+        if (0..2).any(|kind|self.used[kind] && !self.monotone[kind]) { return None; }
+        let scale=core.input.converted_count as f64/(1.0+RELATIVE_ERROR);
+        let reaches=|rank, bonus| {
+            let bonuses: [f64;2]=std::array::from_fn(|kind|if kind==self.selected {bonus} else {self.max_bonus[kind]});
+            let values=std::array::from_fn(|kind|if self.used[kind] {self.reward(kind,bonuses[kind.min(1)],rank) as i128} else {0});
+            let vector=self.levels.iter().map(|level|self.sum(level,&values)*self.observations as i128).collect::<Vec<_>>();
+            vector[self.search_level..]>=frontier[self.search_level..]
+        };
+        let mut targets=Vec::new();
+        for &(rank, required) in &self.eligible {
+            if !reaches(rank,self.max_bonus[self.selected]) { continue; }
+            let (mut low,mut high)=(0i64,self.max_bonus[self.selected].ceil() as i64);
+            while low<high {
+                let mid=(low+high)/2;
+                if reaches(rank,mid as f64) {high=mid;} else {low=mid+1;}
+            }
+            targets.push(JointTarget {bonus:low as f64,product:(required as f64*scale).next_down().max(0.0)});
+        }
+        Some(targets)
+    }
+    fn bonus_floor(&mut self, limit: f64) -> Option<f64> {
+        self.joint_targets(limit).map(|targets|targets.iter().map(|target|target.bonus).fold(f64::INFINITY,f64::min))
+    }
+    fn bound(&mut self, t: Totals) -> f64 {
+        let high = self.core.as_ref().map_or(f64::INFINITY, |c|c.score_high(t));
+        let mut bonuses = self.max_bonus;
+        bonuses[self.selected] = bonuses[self.selected].min(t.bonus);
+        self.projected_bound(high, bonuses)
+    }
+    fn interval(&mut self,_:&Team,t:Totals)->(f64,f64) { (f64::NEG_INFINITY,self.bound(t)) }
+    fn exact(&mut self,team:&Team,power:f64,_:&[f64])->Result<Exact,String> {
+        let bonuses=[self.team_bonus(team,0),self.team_bonus(team,1)];
+        let scores=self.core.as_mut().map(|core|core.evaluate(team,power as i32)).transpose()?;
+        let ranks=if let Some(scores)=&scores {scores.scores.iter().map(|&s|chart::score_rank(&self.chart,s)).collect::<Vec<_>>()}else{vec![self.master.params.skip_rank]};
+        let mut sums=[0i128;3];let mut per_order=Vec::new();
+        for rank in ranks {
+            let mut values=[0i128;3];
+            for ((kind, &used), (val_cell, sum_cell)) in self.used.iter().enumerate().zip(values.iter_mut().zip(&mut sums)) {
+                if used {
+                    let v=Self::whole(self.reward(kind,bonuses[kind.min(1)],rank))?;
+                    *val_cell=v;*sum_cell+=v;
+                }
+            }
+            per_order.push(self.sum(&self.levels[0],&values) as f64);
+        }
+        let vector=self.levels.iter().map(|l|self.sum(l,&sums)).collect::<Vec<_>>();
+        let levels=self.levels.iter().zip(&vector).map(|(l,sum)|json!({"sum":sum.to_string(),"terms":l.iter().map(|t|sums[t.kind].to_string()).collect::<Vec<_>>()})).collect::<Vec<_>>();
+        Ok(Exact {key:vector[self.search_level] as f64,detail:json!({"scores":scores,"skipScore":if self.core.is_none(){Some(chart::skip_score(&self.master,&self.chart,power as i32))}else{None},
+            "prefixValid":vector.starts_with(&self.prefix),"mean":vector[0] as f64/self.observations as f64,"rewardSum":vector[0].to_string(),"orders":self.observations,"levels":levels,"lexVector":vector.iter().map(ToString::to_string).collect::<Vec<_>>(),
+            "bonus":bonuses[self.selected],"challengePoints":sums[2] as f64/self.observations as f64,"directMin":per_order.iter().copied().reduce(f64::min),"directMax":per_order.iter().copied().reduce(f64::max)})})
+    }
+}
