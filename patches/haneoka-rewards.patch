+    route: Route,
+    levels: Vec<Vec<RewardTerm>>,
+    used: [bool; 3],
+    members: [Vec<f64>; 2],
+    snaps: [Vec<f64>; 2],
+    selected: usize,
+    max_bonus: [f64; 2],
