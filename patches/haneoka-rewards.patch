+    }
+    pub(crate) fn ceiling(&self)->f64 {
+        if self.monotone {self.reward(self.max_bonus,self.ceiling_rank).unwrap()} else {f64::INFINITY}
+    }
+    fn rank(&self,score:f64)->Result<i32,String> {
+        if score.fract()!=0.0 || !(0.0..=i32::MAX as f64).contains(&score){return Err("moenotes-reward-score".into());}
+        let score=score as i32;
+        if !self.battle {
+            return self.ranks.iter().rfind(|r|r.required<=score).map(|r|r.rank).ok_or_else(||"moenotes-reward-rank".into());
+        }
+        let peer=self.others.unwrap_or(score);
+        let total=(1..self.players).try_fold(score,|total,_|total.checked_add(peer)).ok_or("moenotes-room-score-overflow")?;
