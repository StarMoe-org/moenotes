+            2=>self.route.challenge_points.get(&rank).map(|&value|crate::num::imul(value,crate::num::i32(self.route.rate)) as f64).ok_or_else(||"moenotes-reward-rank".into()),
+            _=>Err("moenotes-reward-rank".into()),
