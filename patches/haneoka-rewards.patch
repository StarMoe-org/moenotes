+struct SkipScore {
+    master: Master,
+    chart: chart::Chart,
+}
+impl SkipScore {
+    fn new(master: &Master, chart: &chart::Chart) -> Result<Self, String> {
+        let mut combo = 0.0;
+        if let Some(rows) = master.live.combo.get(&0) {
+            for &(required, value) in rows {
+                if required > 0 { break; }
+                combo = value;
+            }
+        }
+        if ![master.live.adjustment, chart.difficulty_factor,
+            master.live.judge_percent.get(&3).copied().unwrap_or(80.0), combo.min(1.0) + 1.0]
+            .into_iter().chain(chart.skip_note_frac.iter().copied()).all(|v| v.is_finite() && v >= 0.0) {
+            return Err("skip-score-nonmonotone".into());
+        }
+        Ok(Self { master: master.clone(), chart: chart.clone() })
+    }
+    fn value(&self, power: f64) -> f64 {
+        chart::skip_score(&self.master, &self.chart, power as i32) as f64
+    }
+}
+impl crate::search::Objective for SkipScore {
+    fn exchange_snap_equivalent(&mut self, _member: usize, _a: i32, _b: i32) -> bool { true }
+    fn conditional_snap_dominance(&self) -> bool { true }
+    fn canonical_leader(&self) -> bool { true }
+    fn skill(&mut self, _member: usize, _snap: i32) -> (f64, f64) { (0.0, 0.0) }
+    fn bound(&mut self, totals: crate::search::Totals) -> f64 { self.value(totals.power.ceil()) }
+    fn interval(&mut self, _team: &crate::search::Team, totals: crate::search::Totals) -> (f64, f64) {
+        let value = self.value(totals.power); (value, value)
+    }
+    fn exact(&mut self, _team: &crate::search::Team, power: f64, _slots: &[f64]) -> Result<crate::search::Exact, String> {
+        let value = self.value(power);
+        Ok(crate::search::Exact { key: value, detail: json!({"skipScore": value}) })
+    }
+}
