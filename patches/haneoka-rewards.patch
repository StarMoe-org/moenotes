+    }
+    fn bound(&mut self, t: Totals) -> f64 {
+        let high = self.core.as_ref().map_or(f64::INFINITY, |c|c.score_high(t));
+        let mut bonuses = self.max_bonus;
+        bonuses[self.selected] = bonuses[self.selected].min(t.bonus);
+        self.projected_bound(high, bonuses)
+    }
+    fn interval(&mut self,_:&Team,t:Totals)->(f64,f64) { (f64::NEG_INFINITY,self.bound(t)) }
+    fn exact(&mut self,team:&Team,power:f64,_:&[f64])->Result<Exact,String> {
+        let bonuses=[self.team_bonus(team,0),self.team_bonus(team,1)];
+        let scores=match &mut self.core {Some(core)=>Some(core.evaluate(team,power as i32)?),None=>None};
+        let ranks=if let Some(scores)=&scores {scores.scores.iter().map(|&s|chart::score_rank(&self.chart,s)).collect::<Vec<_>>()}else{vec![self.master.params.skip_rank]};
+        let mut sums=[0i128;3];let mut per_order=Vec::new();
+        for rank in ranks {let mut values=[0i128;3];for kind in 0..3 {if self.used[kind] {
+            values[kind]=Self::whole(self.reward(kind,bonuses[kind.min(1)],rank))?;sums[kind]+=values[kind];
+        }}per_order.push(self.sum(&self.levels[0],&values) as f64);}
+        let vector=self.levels.iter().map(|l|self.sum(l,&sums)).collect::<Vec<_>>();
+        let levels=self.levels.iter().zip(&vector).map(|(l,sum)|json!({"sum":sum.to_string(),"terms":l.iter().map(|t|sums[t.kind].to_string()).collect::<Vec<_>>()})).collect::<Vec<_>>();
+        Ok(Exact {key:vector[self.search_level] as f64,detail:json!({"scores":scores,"skipScore":if self.core.is_none(){Some(chart::skip_score(&self.master,&self.chart,power as i32))}else{None},
+            "prefixValid":vector.starts_with(&self.prefix),"mean":vector[0] as f64/self.observations as f64,"rewardSum":vector[0].to_string(),"orders":self.observations,"levels":levels,"lexVector":vector.iter().map(ToString::to_string).collect::<Vec<_>>(),
+            "bonus":bonuses[self.selected],"challengePoints":sums[2] as f64/self.observations as f64,"directMin":per_order.iter().copied().reduce(f64::min),"directMax":per_order.iter().copied().reduce(f64::max)})})
+    }
+}
