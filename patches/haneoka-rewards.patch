+            if !reaches(rank,self.max_bonus[self.selected]) { continue; }
+            let (mut low,mut high)=(0i64,self.max_bonus[self.selected].ceil() as i64);
+            while low<high {
+                let mid=(low+high)/2;
+                if reaches(rank,mid as f64) {high=mid;} else {low=mid+1;}
+            }
