---
import CalendarView from "@/components/calendar/CalendarView";
import PageHeader from "@/components/route/PageHeader.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { monthKey, monthOf, calendarDayAt } from "@/lib/calendar/model";
import { getBuildCalendar } from "@/lib/masterdata/build-calendar";
import { getBuildCharacters } from "@/lib/masterdata/build-data";
import { getBuildServers } from "@/lib/masterdata/build-servers";
import { MASTER_TIME_ZONE } from "@/lib/schedule";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const [{ data, birthdays }, { characters }, servers] = await Promise.all([getBuildCalendar(locale), getBuildCharacters(locale), getBuildServers()]);
const characterOptions = characters.map((character) => ({ id: character.id, name: character.name }));
// The static HTML shows the build's month; the browser moves to the reader's.
const buildMonth = monthKey(monthOf(calendarDayAt(Date.now(), MASTER_TIME_ZONE)));
---

<PageLayout locale={locale} titleKey="seo.calendar.title" descriptionKey="seo.calendar.description">
  <PageHeader locale={locale} titleKey="seo.calendar.title" descriptionKey="seo.calendar.description" />
  <CalendarView client:load locale={locale} data={data} birthdays={birthdays} servers={servers} characters={characterOptions} buildMonth={buildMonth} />
</PageLayout>
