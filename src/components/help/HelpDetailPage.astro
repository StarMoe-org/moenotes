---
import HelpDetail from "@/components/help/HelpDetail";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildHelpTopicDetail } from "@/lib/masterdata/build-help";
import { getBuildServers } from "@/lib/masterdata/build-servers";

interface Props {
  locale: AppLocale;
  helpId: number;
}

const { locale, helpId } = Astro.props;
const [detail, servers] = await Promise.all([getBuildHelpTopicDetail(locale, helpId), getBuildServers()]);
---

<PageLayout locale={locale} titleKey="seo.helpDetail.title" descriptionKey="seo.helpDetail.description" showDescription={false}>
  <HelpDetail client:load locale={locale} servers={servers} detail={detail} />
</PageLayout>
