---
import NewsDetail from "@/components/news/NewsDetail";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
---

<PageLayout locale={locale} titleKey="seo.newsDetail.title" descriptionKey="seo.newsDetail.description">
  <NewsDetail client:load locale={locale} />
</PageLayout>
