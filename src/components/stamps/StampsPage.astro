---
import StampsExplorer from "@/components/stamps/StampsExplorer";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildBandNames, getBuildStamps } from "@/lib/masterdata/build-data";
import { getBuildServers } from "@/lib/masterdata/build-servers";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const [stamps, bandNames] = await Promise.all([getBuildStamps(locale), getBuildBandNames(locale)]);
const servers = await getBuildServers();
---

<PageLayout locale={locale} titleKey="seo.stamps.title" descriptionKey="seo.stamps.description">
  <StampsExplorer client:load servers={servers} locale={locale} initialStamps={stamps} initialBandNames={bandNames} />
</PageLayout>
