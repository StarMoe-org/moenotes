---
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { openPlatformDocsUrl } from "@/config/site";
import { resolveDocsUrl } from "@/lib/account/docs-url";
import { t } from "@/i18n";
import { localizePath } from "@/i18n/routing";
import { getRoutePathById } from "@/lib/route/registry";

interface Props { locale: AppLocale }
const { locale } = Astro.props;
const target = resolveDocsUrl(openPlatformDocsUrl, locale);
const consolePath = localizePath(getRoutePathById("open-platform"), locale);
---
<PageLayout locale={locale} titleKey="openPlatform.docs.title" descriptionKey="openPlatform.docs.description">
  <section class="mn-paper max-w-3xl space-y-5 p-6 sm:p-8" data-docs-migration data-docs-base={target ? openPlatformDocsUrl : undefined} data-docs-locale={locale}>
    <p class="text-sm leading-7">{t(locale, target ? "openPlatform.docsMoved" : "openPlatform.docsPending")}</p>
    {target && <a data-docs-target class="mn-focus inline-flex min-h-11 items-center rounded-full border border-[var(--mn-accent)] bg-[var(--mn-accent-soft)] px-5 text-sm font-bold text-[var(--mn-accent-deep)]" href={target}>{t(locale, "openPlatform.docs.title")}</a>}
    <p><a class="mn-focus text-sm font-bold underline" href={consolePath}>{t(locale, "openPlatform.developer")}</a></p>
  </section>
</PageLayout>
<script>
  import { resolveDocsUrl } from "@/lib/account/docs-url";
  function migrateDocumentation() {
    const entry = document.querySelector<HTMLElement>("[data-docs-migration]");
    const base = entry?.dataset.docsBase;
    if (!base) return;
    const target = resolveDocsUrl(base, entry.dataset.docsLocale ?? "en-US", window.location.hash);
    if (!target || target === window.location.href) return;
    const link = entry.querySelector<HTMLAnchorElement>("[data-docs-target]");
    if (link) link.href = target;
    window.location.replace(target);
  }
  migrateDocumentation();
  document.addEventListener("astro:page-load", migrateDocumentation);
</script>
