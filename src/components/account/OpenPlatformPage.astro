---
import PageLayout from "@/layouts/PageLayout.astro";
import OpenPlatformPanel from "@/components/account/OpenPlatformPanel";
import type { AppLocale } from "@/config/locales";
import { t } from "@/i18n";
import { localizePath } from "@/i18n/routing";
import { getRoutePathById } from "@/lib/route/registry";
interface Props { locale: AppLocale }
const { locale } = Astro.props;
---
<PageLayout locale={locale} titleKey="openPlatform.title" descriptionKey="openPlatform.pageDescription">
  <a class="mn-focus mb-5 inline-block font-bold underline" href={localizePath(getRoutePathById("open-platform-docs"), locale)}>{t(locale, "openPlatform.docs.title")}</a>
  <OpenPlatformPanel client:load locale={locale} />
</PageLayout>
