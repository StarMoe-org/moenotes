---
import BackgroundsExplorer from "@/components/backgrounds/BackgroundsExplorer";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildBackgrounds } from "@/lib/masterdata/build-data";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const backgrounds = await getBuildBackgrounds(locale);
---

<PageLayout locale={locale} titleKey="seo.backgrounds.title" descriptionKey="seo.backgrounds.description">
  <BackgroundsExplorer client:load locale={locale} initialBackgrounds={backgrounds} />
</PageLayout>
