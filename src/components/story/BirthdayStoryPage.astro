---
import StoryPage from "@/components/story/StoryPage.astro";
import type { AppLocale } from "@/config/locales";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
---

<StoryPage locale={locale} category="birthday" titleKey="seo.birthdayStory.title" descriptionKey="seo.birthdayStory.description" />
