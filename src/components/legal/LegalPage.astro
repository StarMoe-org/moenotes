---
// Placeholder reserved for the haneoka feature-parity work (.narrafork/plans/plan-parallel-weaving-hellman.md).
import PageHeader from "@/components/route/PageHeader.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";

export type LegalDocument = "license" | "terms" | "privacy";

interface Props {
  locale: AppLocale;
  document: LegalDocument;
}

const { locale, document } = Astro.props;
---

<PageLayout locale={locale} titleKey={`seo.${document}.title`} descriptionKey={`seo.${document}.description`}>
  <PageHeader locale={locale} titleKey={`seo.${document}.title`} descriptionKey={`seo.${document}.description`} />
</PageLayout>
