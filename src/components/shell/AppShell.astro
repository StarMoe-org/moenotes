---
import AssetCacheBootstrap from "@/components/shell/AssetCacheBootstrap.astro";
import CommandPalette from "@/components/shell/CommandPalette";
import Header from "@/components/shell/Header";
import KeyboardShortcutsHelp from "@/components/shell/KeyboardShortcutsHelp";
import OverlayHost from "@/components/shell/OverlayHost";
import ScrollRestorer from "@/components/shell/ScrollRestorer.astro";
import ScrollToTop from "@/components/shared/ScrollToTop";
import AudioDock from "@/components/shell/AudioDock";
import SettingsDialog from "@/components/shell/SettingsDialog";
import Sidebar from "@/components/shell/Sidebar";
import FilterDrawerHost from "@/components/shell/filter-drawer/FilterDrawerHost";
import Footer from "@/components/shell/Footer.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildThemeBands } from "@/lib/masterdata/build-settings";
import type { BreadcrumbDetail } from "@/types/route";

interface Props {
  locale: AppLocale;
  pathname: string;
  breadcrumbDetail?: BreadcrumbDetail | undefined;
}

const { locale, pathname, breadcrumbDetail } = Astro.props;
const activePath = breadcrumbDetail?.ancestors?.at(-1)?.path;
// Band colors for the settings' theme color choice (memoized per locale, so every page shares one lookup).
const themeBands = await getBuildThemeBands(locale);
---

<AssetCacheBootstrap />
<Header client:load locale={locale} pathname={pathname} breadcrumbDetail={breadcrumbDetail} />
<Sidebar client:load locale={locale} pathname={pathname} activePath={activePath} />
<FilterDrawerHost client:load locale={locale} pathname={pathname} />
<main id="content" class="mx-auto min-h-screen max-w-[120rem] px-4 pb-16 pt-[var(--mn-header-bottom,5rem)] transition-[padding] duration-300 md:pl-[calc(var(--mn-sidebar-offset,18rem)+var(--mn-filter-offset,0rem)+1.5rem)] md:pr-6 md:pt-24">
  <slot />
</main>
<Footer locale={locale} />
<CommandPalette client:idle locale={locale} />
<SettingsDialog client:idle locale={locale} pathname={pathname} bands={themeBands} />
<KeyboardShortcutsHelp client:idle locale={locale} />
<ScrollRestorer />
<OverlayHost client:load locale={locale} />
<ScrollToTop client:idle locale={locale} />
<AudioDock client:idle locale={locale} />
