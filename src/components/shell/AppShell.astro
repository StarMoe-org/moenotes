---
import AssetCacheBootstrap from "@/components/shell/AssetCacheBootstrap.astro";
import CommandPalette from "@/components/shell/CommandPalette";
import Header from "@/components/shell/Header.astro";
import HeaderActions, { HamburgerButtons } from "@/components/shell/HeaderActions";
import KeyboardShortcutsHelp from "@/components/shell/KeyboardShortcutsHelp";
import OverlayHost from "@/components/shell/OverlayHost";
import ScrollRestorer from "@/components/shell/ScrollRestorer.astro";
import ScrollToTop from "@/components/shared/ScrollToTop";
import SettingsDrawer from "@/components/shell/SettingsDrawer";
import Sidebar from "@/components/shell/Sidebar";
import Footer from "@/components/shell/Footer.astro";
import type { AppLocale } from "@/config/locales";
import { buildBreadcrumbs } from "@/lib/route/breadcrumbs";

interface Props {
  locale: AppLocale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const crumbs = buildBreadcrumbs(pathname, locale);
const hasCrumbs = crumbs.length > 1;
---

<AssetCacheBootstrap />
<Header locale={locale} pathname={pathname}>
  <HamburgerButtons slot="hamburger" client:load locale={locale} />
  <HeaderActions client:load locale={locale} />
</Header>
<Sidebar client:load locale={locale} pathname={pathname} hasCrumbs={hasCrumbs} />
<main id="content" class:list={["mx-auto min-h-screen max-w-7xl px-4 pb-16 transition-[padding] duration-300 md:pl-[calc(var(--mn-sidebar-offset,18rem)+1.5rem)] md:pr-6 md:pt-28", hasCrumbs ? "pt-36" : "pt-24"]}>
  <slot />
</main>
<Footer locale={locale} />
<CommandPalette client:load locale={locale} />
<SettingsDrawer client:load locale={locale} pathname={pathname} />
<KeyboardShortcutsHelp client:load locale={locale} />
<ScrollRestorer />
<OverlayHost client:load locale={locale} />
<ScrollToTop client:load />
