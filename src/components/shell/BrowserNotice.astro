---
import type { AppLocale } from "@/config/locales";
import { siteConfig } from "@/config/site";
import { storageKeys } from "@/config/storage";
import { t } from "@/i18n";
import { buildBrowserNoticeScript, recommendedBrowsers } from "@/lib/browser/browser-notice";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const templateId = "mn-browser-notice";
const titleId = `${templateId}-title`;
const recommended = recommendedBrowsers(locale);
const platforms = [
  { platform: "android", text: t(locale, "browserNotice.android"), browsers: recommended.android },
  { platform: "desktop", text: t(locale, "browserNotice.desktop"), browsers: recommended.desktop },
];
const script = buildBrowserNoticeScript({ templateId, storageKey: storageKeys.browserNoticeDismissed });
---

<!-- Inert until the script decides this browser needs it; plain CSS, since Tailwind may not apply here. -->
<template id={templateId}>
  <aside class="mn-browser-notice" data-browser-notice aria-labelledby={titleId}>
    <p id={titleId} class="mn-browser-notice-title">{t(locale, "browserNotice.title")}</p>
    <p>{t(locale, "browserNotice.description")}</p>
    <p class="mn-browser-notice-hint" data-browser-notice-only="in-app">{t(locale, "browserNotice.inAppHint")}</p>
    <p class="mn-browser-notice-hint" data-browser-notice-only="ios">{t(locale, "browserNotice.ios")}</p>
    {platforms.map(({ platform, text, browsers }) => (
      <div data-browser-notice-only={platform}>
        <p class="mn-browser-notice-hint">{text}</p>
        <p class="mn-browser-notice-links">
          {browsers.map((id) => {
            const browser = siteConfig.recommendedBrowsers[id];
            return <a href={browser.url} target="_blank" rel="noopener noreferrer">{t(locale, "browserNotice.download", { name: browser.name })}</a>;
          })}
        </p>
      </div>
    ))}
    <button type="button" class="mn-browser-notice-close" data-browser-notice-close aria-label={t(locale, "browserNotice.dismiss")} title={t(locale, "browserNotice.dismiss")}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </aside>
</template>
<script is:inline set:html={script}></script>
