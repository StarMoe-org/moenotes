---
import BrandLogo from "@/components/shared/BrandLogo";
import Breadcrumbs from "@/components/shell/Breadcrumbs.astro";
import type { AppLocale } from "@/config/locales";
import { localizePath } from "@/i18n/routing";
import { buildBreadcrumbs } from "@/lib/route/breadcrumbs";
import type { BreadcrumbDetail } from "@/types/route";

interface Props {
  locale: AppLocale;
  pathname: string;
  breadcrumbDetail?: BreadcrumbDetail | undefined;
}

const { locale, pathname, breadcrumbDetail } = Astro.props;
const crumbs = buildBreadcrumbs(pathname, locale, breadcrumbDetail);
const hasCrumbs = crumbs.length > 1;
---

<header class="fixed top-3 left-1/2 z-40 -translate-x-1/2 w-[calc(100%-1.5rem)] max-w-[var(--mn-layout-max-width,120rem)] sm:top-4 sm:w-[calc(100%-2rem)]">
  <div id="header-card" class:list={["w-full border-[1.5px] border-[var(--mn-border)] bg-[var(--mn-bg)]/95 px-3 py-2 shadow-[var(--mn-shadow)] backdrop-blur-sm sm:px-6 pointer-events-auto transition-all duration-300", hasCrumbs ? "rounded-[24px] md:rounded-full" : "rounded-full"]}>
    <div class="flex items-center gap-2 sm:gap-3">
      <slot name="hamburger" />

      <div class="flex items-center gap-0.5">
        <a href={localizePath("/", locale)} class="flex items-center text-[var(--mn-text)]">
          <BrandLogo className="mn-brand-shell" />
        </a>

        {hasCrumbs && (
          <button
            id="breadcrumbs-toggle"
            class="mn-focus flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[var(--mn-text-muted)] transition hover:bg-[var(--mn-cream-deep)] hover:text-[var(--mn-text)] md:hidden"
            aria-label="Toggle breadcrumbs"
            aria-expanded="false"
            aria-controls="mobile-breadcrumbs-container"
          >
            <svg id="toggle-chevron" style="transition: transform 0.3s ease;" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        )}
      </div>

      <Breadcrumbs locale={locale} pathname={pathname} detail={breadcrumbDetail} mode="desktop" />

      <slot />
    </div>

    {hasCrumbs && (
      <div id="mobile-breadcrumbs-container" class="md:hidden overflow-hidden transition-all duration-300 ease-in-out px-1 max-h-0 mt-0">
        <div class="pt-2 mt-2 border-t border-dashed border-[var(--mn-border)]/15">
          <Breadcrumbs locale={locale} pathname={pathname} detail={breadcrumbDetail} mode="mobile" />
        </div>
      </div>
    )}
  </div>
</header>

<script>
  import { storageKeys } from "@/config/storage";
  import { safeGetLocalStorage, safeSetLocalStorage } from "@/lib/storage/safe-storage";

  const teardownKey = "__moenotesHeaderTeardown";
  const initKey = "__moenotesHeaderInit";
  const beforeSwapKey = "__moenotesHeaderBeforeSwap";

  const getStoredOpen = (): boolean => {
    const stored = safeGetLocalStorage(storageKeys.breadcrumbsOpen);
    return stored === null ? true : stored === "true";
  };

  const setStoredOpen = (open: boolean): void => {
    safeSetLocalStorage(storageKeys.breadcrumbsOpen, String(open));
  };

  const init = () => {
    (window as unknown as Record<string, (() => void) | undefined>)[teardownKey]?.();

    const toggleBtn = document.getElementById("breadcrumbs-toggle");
    const container = document.getElementById("mobile-breadcrumbs-container");
    const chevron = document.getElementById("toggle-chevron");
    const headerCard = document.getElementById("header-card");
    const root = document.documentElement;
    const mediaQuery = window.matchMedia("(max-width: 767.98px)");
    let overflowTimer: number | undefined;
    let headerResizeObserver: ResizeObserver | undefined;

    const clearOverflowTimer = () => {
      if (overflowTimer) {
        window.clearTimeout(overflowTimer);
        overflowTimer = undefined;
      }
    };

    const updateHeaderOffset = () => {
      if (!headerCard || !mediaQuery.matches) {
        root.style.removeProperty("--mn-header-bottom");
        return;
      }

      root.style.setProperty("--mn-header-bottom", `${headerCard.offsetHeight + 24}px`);
    };

    const setOpen = (isOpen: boolean, animate = true) => {
      if (!toggleBtn || !container || !chevron) return;

      clearOverflowTimer();
      container.classList.toggle("is-open", isOpen);
      toggleBtn.setAttribute("aria-expanded", String(isOpen));
      toggleBtn.classList.toggle("bg-[var(--mn-accent-soft)]", isOpen);
      toggleBtn.classList.toggle("text-[var(--mn-accent-deep)]", isOpen);
      toggleBtn.classList.toggle("text-[var(--mn-text-muted)]", !isOpen);

      if (!animate) {
        container.style.transition = "none";
        chevron.style.transition = "none";
      }

      chevron.style.transform = isOpen ? "rotate(180deg)" : "rotate(0deg)";

      if (!mediaQuery.matches) {
        container.style.maxHeight = "";
        container.style.overflow = "";
        updateHeaderOffset();
        if (!animate) {
          void container.offsetHeight;
          container.style.transition = "";
          chevron.style.transition = "";
        }
        return;
      }

      container.style.overflow = isOpen && !animate ? "visible" : "hidden";
      container.style.maxHeight = isOpen ? `${container.scrollHeight}px` : "0";
      updateHeaderOffset();

      if (!animate) {
        void container.offsetHeight;
        container.style.transition = "";
        chevron.style.transition = "";
      } else if (isOpen) {
        overflowTimer = window.setTimeout(() => {
          if (container.classList.contains("is-open")) {
            container.style.overflow = "visible";
          }
        }, 300);
      }
    };

    const handleToggle = () => {
      const willOpen = !container?.classList.contains("is-open");
      setStoredOpen(willOpen);
      setOpen(willOpen, true);
    };

    const handleResize = () => {
      const isOpen = container?.classList.contains("is-open") ?? false;
      setOpen(isOpen, false);
    };

    const handleStorage = (e: StorageEvent) => {
      if (e.key === storageKeys.breadcrumbsOpen && e.newValue !== null) {
        setOpen(e.newValue === "true", true);
      }
    };

    if (headerCard && "ResizeObserver" in window) {
      headerResizeObserver = new ResizeObserver(updateHeaderOffset);
      headerResizeObserver.observe(headerCard);
    }

    document.fonts?.ready.then(() => {
      if (container?.classList.contains("is-open") && mediaQuery.matches) {
        container.style.maxHeight = `${container.scrollHeight}px`;
      }
      updateHeaderOffset();
    }).catch(() => {});

    if (toggleBtn && container && chevron && headerCard) {
      setOpen(getStoredOpen(), false);
      toggleBtn.addEventListener("click", handleToggle);
      window.addEventListener("resize", handleResize);
      window.addEventListener("storage", handleStorage);
    } else {
      updateHeaderOffset();
      window.addEventListener("resize", updateHeaderOffset);
    }

    (window as unknown as Record<string, (() => void) | undefined>)[teardownKey] = () => {
      clearOverflowTimer();
      headerResizeObserver?.disconnect();
      toggleBtn?.removeEventListener("click", handleToggle);
      window.removeEventListener("resize", handleResize);
      window.removeEventListener("resize", updateHeaderOffset);
      window.removeEventListener("storage", handleStorage);
    };
  };

  const win = window as unknown as Record<string, (() => void) | undefined>;
  if (win[initKey]) {
    document.removeEventListener("astro:page-load", win[initKey]!);
    document.removeEventListener("DOMContentLoaded", win[initKey]!);
  }
  if (win[beforeSwapKey]) {
    document.removeEventListener("astro:before-swap", win[beforeSwapKey]!);
  }

  win[initKey] = init;
  win[beforeSwapKey] = () => (window as unknown as Record<string, (() => void) | undefined>)[teardownKey]?.();

  init();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  }

  document.addEventListener("astro:page-load", win[initKey]!);
  document.addEventListener("astro:before-swap", win[beforeSwapKey]!);
</script>

