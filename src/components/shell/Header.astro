---
import Breadcrumbs from "@/components/shell/Breadcrumbs.astro";
import type { AppLocale } from "@/config/locales";
import { localizePath } from "@/i18n/routing";

interface Props {
  locale: AppLocale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
---

<header class="fixed inset-x-4 top-4 z-40">
  <div class="rounded-full border-[1.5px] border-[var(--mn-border)] bg-[var(--mn-bg)]/95 px-3 py-2 shadow-[var(--mn-shadow)] backdrop-blur-sm sm:px-6">
    <div class="flex items-center gap-3">
      <slot name="hamburger" />

      <a href={localizePath("/", locale)} class="flex items-center text-[var(--mn-text)]">
        <span class="leading-none">
          <span class="block font-[var(--mn-font-display)] text-xl font-black tracking-tight sm:text-2xl">Moenotes</span>
          <span class="hidden font-[var(--mn-font-display)] text-[10px] uppercase tracking-[0.2em] text-[var(--mn-text-muted)] sm:block">OURNOTES VIEWER</span>
        </span>
      </a>

      <Breadcrumbs locale={locale} pathname={pathname} />

      <slot />
    </div>
  </div>
</header>

