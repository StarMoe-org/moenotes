---
import Breadcrumbs from "@/components/shell/Breadcrumbs.astro";
import type { AppLocale } from "@/config/locales";
import { localizePath } from "@/i18n/routing";
import { buildBreadcrumbs } from "@/lib/route/breadcrumbs";

interface Props {
  locale: AppLocale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const crumbs = buildBreadcrumbs(pathname, locale);
const hasCrumbs = crumbs.length > 1;
---

<header class="fixed inset-x-4 top-4 z-40">
  <div class:list={["w-full border-[1.5px] border-[var(--mn-border)] bg-[var(--mn-bg)]/95 px-3 shadow-[var(--mn-shadow)] backdrop-blur-sm sm:px-6 pointer-events-auto transition-all duration-300", hasCrumbs ? "rounded-[24px] py-2.5 md:rounded-full md:py-2" : "rounded-full py-2"]}>
    <div class="flex items-center gap-3">
      <slot name="hamburger" />

      <a href={localizePath("/", locale)} class="flex items-center text-[var(--mn-text)]">
        <span class="leading-none">
          <span class="block font-[var(--mn-font-display)] text-xl font-black tracking-tight sm:text-2xl">Moenotes</span>
          <span class="hidden font-[var(--mn-font-display)] text-[10px] uppercase tracking-[0.2em] text-[var(--mn-text-muted)] sm:block">OURNOTES VIEWER</span>
        </span>
      </a>

      <Breadcrumbs locale={locale} pathname={pathname} mode="desktop" />

      <slot />
    </div>

    {hasCrumbs && (
      <div class="md:hidden mt-2 pt-2 border-t border-dashed border-[var(--mn-border)]/15 px-1">
        <Breadcrumbs locale={locale} pathname={pathname} mode="mobile" />
      </div>
    )}
  </div>
</header>

