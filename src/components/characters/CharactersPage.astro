---
import CharactersExplorer from "@/components/characters/CharactersExplorer";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildCharacters } from "@/lib/masterdata/build-data";
import { getBuildServers } from "@/lib/masterdata/build-servers";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const characters = await getBuildCharacters(locale);
const servers = await getBuildServers();
---

<PageLayout locale={locale} titleKey="seo.characters.title" descriptionKey="seo.characters.description">
  <CharactersExplorer client:load servers={servers} locale={locale} initialCharacters={characters} />
</PageLayout>
