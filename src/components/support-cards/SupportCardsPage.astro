---
import SupportCardsExplorer from "@/components/support-cards/SupportCardsExplorer";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
---

<PageLayout locale={locale} titleKey="seo.supportCards.title" descriptionKey="seo.supportCards.description">
  <SupportCardsExplorer client:load locale={locale} />
</PageLayout>
