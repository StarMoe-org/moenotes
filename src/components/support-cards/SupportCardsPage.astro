---
import SupportCardsExplorer from "@/components/support-cards/SupportCardsExplorer";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildSupportCards } from "@/lib/masterdata/build-data";
import { getBuildServers } from "@/lib/masterdata/build-servers";
import { getBuildCardSkillNames } from "@/lib/masterdata/build-card-skill-names";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const cards = await getBuildSupportCards(locale);
const servers = await getBuildServers();
const skillNames = await getBuildCardSkillNames(locale);
---

<PageLayout locale={locale} titleKey="seo.supportCards.title" descriptionKey="seo.supportCards.description">
  <SupportCardsExplorer client:load servers={servers} locale={locale} initialSupportCards={cards} skillNames={skillNames} />
</PageLayout>
