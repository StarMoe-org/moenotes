---
import SupportCardDetail from "@/components/support-cards/SupportCardDetail";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildSupportCardDetail } from "@/lib/masterdata/build-data";

interface Props {
  locale: AppLocale;
  supportCardId: number;
}

const { locale, supportCardId } = Astro.props;
const initialData = await getBuildSupportCardDetail(locale, supportCardId);
---

<PageLayout locale={locale} titleKey="seo.supportCardDetail.title" descriptionKey="seo.supportCardDetail.description">
  <SupportCardDetail client:load locale={locale} supportCardId={supportCardId} initialData={initialData} />
</PageLayout>
