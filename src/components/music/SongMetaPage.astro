---
import SongMetaTable from "@/components/music/SongMetaTable";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildMusic } from "@/lib/masterdata/build-data";
import { getBuildServers } from "@/lib/masterdata/build-servers";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const [songs, servers] = await Promise.all([getBuildMusic(locale), getBuildServers()]);
---

<PageLayout locale={locale} titleKey="seo.songMeta.title" descriptionKey="seo.songMeta.description">
  <SongMetaTable client:load locale={locale} servers={servers} initialSongs={songs} />
</PageLayout>
