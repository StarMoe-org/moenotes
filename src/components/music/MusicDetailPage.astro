---
import MusicDetail from "@/components/music/MusicDetail";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildMusicDetail, getBuildMusicDetailData } from "@/lib/masterdata/build-data";
import { getBuildMusicLiveExtras } from "@/lib/masterdata/build-music";
import { getBuildServers } from "@/lib/masterdata/build-servers";

interface Props {
  locale: AppLocale;
  songId: number;
}

const { locale, songId } = Astro.props;
const [song, detail, extras, servers] = await Promise.all([
  getBuildMusicDetail(locale, songId),
  getBuildMusicDetailData(locale, songId),
  getBuildMusicLiveExtras(locale, songId),
  getBuildServers(),
]);
---

<PageLayout locale={locale} titleKey="seo.songDetail.title" descriptionKey="seo.songDetail.description">
  <MusicDetail client:load servers={servers} locale={locale} songId={songId} initialSong={song} liveDetail={detail?.value ?? null} liveExtras={extras} />
</PageLayout>
