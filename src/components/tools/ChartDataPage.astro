---
import ChartDataTool from "@/components/chart-data/ChartDataTool";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getChartDataGuide } from "@/i18n/guides/chart-data";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
// The chart figures come from music-data.json in the browser (assetConfig.musicDataSite); the guide ships with the page
// in the page's language only.
const guide = getChartDataGuide(locale);
---

<PageLayout locale={locale} titleKey="seo.chartData.title" descriptionKey="seo.chartData.description">
  <ChartDataTool client:load locale={locale} guide={guide} />
</PageLayout>
