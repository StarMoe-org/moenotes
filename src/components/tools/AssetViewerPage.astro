---
import AssetViewer from "@/components/tools/AssetViewer";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
---

<PageLayout locale={locale} titleKey="seo.assetViewer.title" descriptionKey="seo.assetViewer.description">
  <AssetViewer client:load locale={locale} />
</PageLayout>
