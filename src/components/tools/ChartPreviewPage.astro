---
import ChartPreview from "@/components/tools/ChartPreview";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildMusic } from "@/lib/masterdata/build-data";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const songs = await getBuildMusic(locale);
---

<PageLayout locale={locale} titleKey="seo.chartPreview.title" descriptionKey="seo.chartPreview.description">
  <ChartPreview client:load locale={locale} songs={songs} />
</PageLayout>
