---
import StoryPlayerTool from "@/components/tools/StoryPlayerTool";
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { getBuildStories } from "@/lib/masterdata/build-data";
import { storyEpisodeLabel } from "@/lib/story/labels";
import type { StoryPickerStory } from "@/lib/story/player-data";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
// Names, groups and artwork come from the build's story data; which episodes can be played is read at runtime
// (stories.json of the story site), so newly published stories need no rebuild.
const stories: StoryPickerStory[] = (await getBuildStories(locale)).map((story) => ({
  advId: story.advId,
  category: story.category,
  title: story.title,
  groupId: story.groupId,
  groupTitle: story.groupTitle || story.bandName,
  groupSubtitle: story.category === "main" || story.category === "event" ? story.bandName : "",
  groupImage: (story.category === "main" || story.category === "event") && (story.chapterBanner || story.chapterImage)
    ? `Story/${story.chapterBanner ? "Banner" : "Image"}/Chapter/${story.chapterBanner || story.chapterImage}`
    : "",
  episodeLabel: storyEpisodeLabel(locale, story),
  episodeKind: story.episodeKind,
  episodeNote: story.episodeKind === "another" ? story.characterNames[0] ?? "" : "",
  // The banners of the story pages: main and bond episodes have one (a bond story may use its pair's).
  image: (story.category === "main" || story.category === "event" || story.category === "friendship") && (story.assets.banner || story.assets.image)
    ? `Story/Banner/${story.assets.banner ? "Episode" : "Chapter"}/${story.assets.banner || story.assets.image}`
    : "",
  searchText: story.searchText,
}));
---

<PageLayout locale={locale} titleKey="seo.storyPlayer.title" descriptionKey="seo.storyPlayer.description">
  <StoryPlayerTool client:load locale={locale} stories={stories} />
</PageLayout>
