---
import type { AppLocale } from "@/config/locales";
import { t } from "@/i18n";
import { localizePath } from "@/i18n/routing";
import { getRoutePathById } from "@/lib/route/registry";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const databasePath = getRoutePathById("database");
const aboutPath = getRoutePathById("community");

const features = [
  {
    id: "characters",
    routeId: "characters",
    color: "pink",
    // Users icon
    iconPath: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />`
  },
  {
    id: "cards",
    routeId: "cards",
    color: "cyan",
    // Sparkles icon
    iconPath: `<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" /><path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5 5 3Z" opacity="0.5" /><path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1 1-2.5Z" opacity="0.5" />`
  },
  {
    id: "supportCards",
    routeId: "support-cards",
    color: "amber",
    // Badge/shield icon
    iconPath: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" />`
  },
  {
    id: "music",
    routeId: "music",
    color: "mint",
    // Music note icon
    iconPath: `<path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />`
  },
  {
    id: "events",
    routeId: "events",
    color: "yellow",
    // Calendar icon
    iconPath: `<rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" />`
  },
  {
    id: "toolbox",
    routeId: "toolbox",
    color: "accent",
    // Wrench/tool icon
    iconPath: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />`
  }
] as const;
---

<section class="relative overflow-hidden rounded-3xl border-[1.5px] border-[var(--mn-border)] bg-[var(--mn-paper)] p-6 shadow-[var(--mn-shadow)] sm:p-10 lg:p-12">
  <div class="mn-halftone absolute right-6 top-6 h-32 w-32 text-[var(--mn-accent)] opacity-10"></div>
  <div class="relative max-w-4xl">
    <p class="mb-3 font-[var(--mn-font-hand)] text-2xl font-bold text-[var(--mn-accent-deep)]">{t(locale, "home.eyebrow")}</p>
    <h1 class="max-w-3xl font-[var(--mn-font-display)] text-5xl leading-[0.95] tracking-tight text-[var(--mn-text)] sm:text-7xl lg:text-8xl">
      <span class="mn-hand-underline">{t(locale, "home.title")}</span>
    </h1>
    <p class="mt-6 max-w-2xl text-xl font-black text-[var(--mn-text)]">{t(locale, "home.subtitle")}</p>
    <p class="mt-4 max-w-2xl text-base font-medium leading-8 text-[var(--mn-text-muted)]">{t(locale, "home.description")}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={localizePath(databasePath, locale)} class="mn-stamp mn-stamp-press rounded-full px-6 py-3.5 text-sm font-black shadow-[var(--mn-shadow-stamp)]">{t(locale, "home.ctaPrimary")}</a>
      <a href={localizePath(aboutPath, locale)} class="mn-stamp-press rounded-full border-2 border-[var(--mn-border)] bg-[var(--mn-surface-strong)] px-6 py-3.5 text-sm font-black text-[var(--mn-text)] shadow-[var(--mn-shadow-stamp)] hover:bg-[var(--mn-cream-deep)]">{t(locale, "home.ctaSecondary")}</a>
    </div>
  </div>
</section>

<section class="mt-12">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="font-[var(--mn-font-hand)] text-xl font-bold text-[var(--mn-accent-deep)]">MoeNotes Index</p>
      <h2 class="font-[var(--mn-font-display)] text-3xl tracking-tight text-[var(--mn-text)] sm:text-5xl">{t(locale, "home.featuresTitle")}</h2>
    </div>
  </div>
  
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((feature) => {
      const path = getRoutePathById(feature.routeId);
      const colorClass = 
        feature.color === "pink" ? "bg-[var(--mn-pink)]/25 text-[var(--mn-accent-deep)] border-[var(--mn-accent-deep)]/20" :
        feature.color === "cyan" ? "bg-[var(--mn-cyan)]/25 text-[#1e5a75] border-[var(--mn-cyan)]/30" :
        feature.color === "amber" ? "bg-[var(--mn-amber)]/25 text-[#7f5c22] border-[var(--mn-amber)]/30" :
        feature.color === "mint" ? "bg-[var(--mn-mint)]/25 text-[var(--mn-mint-deep)] border-[var(--mn-mint-deep)]/20" :
        feature.color === "yellow" ? "bg-[var(--mn-yellow)]/25 text-[#796414] border-[var(--mn-yellow)]/30" :
        "bg-[var(--mn-accent)]/20 text-[var(--mn-accent-deep)] border-[var(--mn-accent)]/25";

      return (
        <a 
          href={localizePath(path, locale)} 
          class="mn-card mn-stamp-press-lg group flex flex-col justify-between p-6 transition-all duration-300 hover:border-[var(--mn-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--mn-accent)]"
        >
          <div>
            <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-full border-[1.5px] ${colorClass} shadow-[var(--mn-shadow-stamp-sm)]`}>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={feature.iconPath} />
            </div>
            <h3 class="text-lg font-black text-[var(--mn-text)] group-hover:text-[var(--mn-accent-deep)] transition-colors duration-200">
              {t(locale, `home.features.${feature.id}`)}
            </h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-[var(--mn-text-muted)]">
              {t(locale, `home.features.${feature.id}Desc`)}
            </p>
          </div>
          
          <div class="mt-6 flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-widest text-[var(--mn-accent-deep)] opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              {t(locale, "actions.open")}
            </span>
            <span class="text-lg font-black text-[var(--mn-text-muted)] group-hover:text-[var(--mn-accent-deep)] transition-all duration-200 transform group-hover:translate-x-1">
              →
            </span>
          </div>
        </a>
      );
    })}
  </div>
</section>
