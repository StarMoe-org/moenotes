---
import type { AppLocale } from "@/config/locales";
import { t } from "@/i18n";
import { localizePath } from "@/i18n/routing";
import { getRoutePathById } from "@/lib/route/registry";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const features = ["i18n", "breadcrumb", "masterdata", "settings", "scroll", "seo"] as const;
const databasePath = getRoutePathById("database");
const aboutPath = getRoutePathById("community");
---

<section class="relative overflow-hidden rounded-3xl border-[1.5px] border-[var(--mn-border)] bg-[var(--mn-paper)] p-6 shadow-[var(--mn-shadow)] sm:p-10 lg:p-12">
  <div class="mn-halftone absolute right-6 top-6 h-32 w-32 text-[var(--mn-accent)] opacity-10"></div>
  <div class="relative max-w-4xl">
    <p class="mb-3 font-[var(--mn-font-hand)] text-2xl font-bold text-[var(--mn-accent-deep)]">{t(locale, "home.eyebrow")}</p>
    <h1 class="max-w-3xl font-[var(--mn-font-display)] text-5xl leading-[0.95] tracking-tight text-[var(--mn-text)] sm:text-7xl lg:text-8xl">
      <span class="mn-hand-underline">{t(locale, "home.title")}</span>
    </h1>
    <p class="mt-6 max-w-2xl text-xl font-black text-[var(--mn-text)]">{t(locale, "home.subtitle")}</p>
    <p class="mt-4 max-w-2xl text-base font-medium leading-8 text-[var(--mn-text-muted)]">{t(locale, "home.description")}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={localizePath(databasePath, locale)} class="mn-stamp mn-stamp-press rounded-full px-6 py-3.5 text-sm font-black shadow-[var(--mn-shadow-stamp)]">{t(locale, "home.ctaPrimary")}</a>
      <a href={localizePath(aboutPath, locale)} class="mn-stamp-press rounded-full border-2 border-[var(--mn-border)] bg-[var(--mn-surface-strong)] px-6 py-3.5 text-sm font-black text-[var(--mn-text)] shadow-[var(--mn-shadow-stamp)] hover:bg-[var(--mn-cream-deep)]">{t(locale, "home.ctaSecondary")}</a>
    </div>
  </div>
</section>

<section class="mt-12">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="font-[var(--mn-font-hand)] text-xl font-bold text-[var(--mn-accent-deep)]">Foundation notes</p>
      <h2 class="font-[var(--mn-font-display)] text-3xl tracking-tight text-[var(--mn-text)] sm:text-5xl">{t(locale, "home.featuresTitle")}</h2>
    </div>
  </div>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((feature) => (
      <article class="relative rounded-3xl border-[1.5px] border-[var(--mn-border)] bg-[var(--mn-paper)] p-5 shadow-[var(--mn-shadow)]">
        <div class="mb-4 grid h-11 w-11 place-items-center rounded-full border-[1.5px] border-[var(--mn-border)] bg-[var(--mn-accent)] text-[var(--mn-paper)] shadow-[var(--mn-shadow-stamp-sm)]">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.75 14.35 9.65 21.25 12 14.35 14.35 12 21.25 9.65 14.35 2.75 12 9.65 9.65Z" />
          </svg>
        </div>
        <h3 class="text-lg font-black text-[var(--mn-text)]">{t(locale, `home.features.${feature}`)}</h3>
      </article>
    ))}
  </div>
</section>
