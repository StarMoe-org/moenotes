---
import DesignSystemPage from "@/components/design-system/DesignSystemPage.astro";
import CardsPage from "@/components/cards/CardsPage.astro";
import CardDetailPage from "@/components/cards/CardDetailPage.astro";
import SupportCardsPage from "@/components/support-cards/SupportCardsPage.astro";
import SupportCardDetailPage from "@/components/support-cards/SupportCardDetailPage.astro";
import CharactersPage from "@/components/characters/CharactersPage.astro";
import CharacterDetailPage from "@/components/characters/CharacterDetailPage.astro";
import AboutPage from "@/components/about/AboutPage.astro";
import Hero from "@/components/home/Hero.astro";
import MusicPage from "@/components/music/MusicPage.astro";
import MusicDetailPage from "@/components/music/MusicDetailPage.astro";
import StampsPage from "@/components/stamps/StampsPage.astro";
import ComicsPage from "@/components/comics/ComicsPage.astro";
import ItemsPage from "@/components/items/ItemsPage.astro";
import GroupLanding from "@/components/route/GroupLanding.astro";
import PageHeader from "@/components/route/PageHeader.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { DEFAULT_LOCALE, PATH_PREFIX_LOCALE, type AppLocale } from "@/config/locales";
import { findRouteMatch } from "@/lib/route/registry";
import { getStaticLocalizedPaths, type StaticLocalizedPathProps } from "@/lib/route/static-paths";
import { stripLocaleFromPathname } from "@/i18n/routing";

export async function getStaticPaths() {
  return await getStaticLocalizedPaths();
}

const props = Astro.props as Partial<StaticLocalizedPathProps>;
const raw = Astro.params.locale ?? "";
const segments = raw.split("/").filter(Boolean);
const maybeLocale = PATH_PREFIX_LOCALE[segments[0] ?? ""];
const locale: AppLocale = props.locale ?? maybeLocale ?? DEFAULT_LOCALE;
const routePath = maybeLocale ? `/${segments.slice(1).join("/")}` : `/${segments.join("/")}`;
const pathname = props.pathname ?? (routePath === "/" ? "/" : stripLocaleFromPathname(routePath));
const match = props.match ?? findRouteMatch(pathname);

if (!match) {
  return Astro.redirect(locale === DEFAULT_LOCALE ? "/" : `/${segments[0]}`);
}

const component = match.item.component ?? "page";
---

<AppLayout locale={locale} pathname={pathname} meta={props.meta} breadcrumbDetail={props.breadcrumbDetail}>
  {component === "home" ? (
    <Hero locale={locale} />
  ) : component === "about" ? (
    <AboutPage locale={locale} />
  ) : component === "cards" ? (

    <CardsPage locale={locale} />
  ) : component === "card-detail" ? (
    <CardDetailPage locale={locale} cardId={Number(match.params.id)} />
  ) : component === "support-cards" ? (
    <SupportCardsPage locale={locale} />
  ) : component === "support-card-detail" ? (
    <SupportCardDetailPage locale={locale} supportCardId={Number(match.params.id)} />
  ) : component === "music" ? (
    <MusicPage locale={locale} />
  ) : component === "song-detail" ? (
    <MusicDetailPage locale={locale} songId={Number(match.params.id)} />
  ) : component === "stamps" ? (
    <StampsPage locale={locale} />
  ) : component === "comics" ? (
    <ComicsPage locale={locale} />
  ) : component === "items" ? (
    <ItemsPage locale={locale} />
  ) : component === "characters" ? (
    <CharactersPage locale={locale} />
  ) : component === "character-detail" ? (
    <CharacterDetailPage locale={locale} characterId={Number(match.params.id)} />
  ) : component === "design-system" ? (
    <DesignSystemPage locale={locale} />
  ) : (
    <PageLayout locale={locale} titleKey={match.item.seo.titleKey} descriptionKey={match.item.seo.descriptionKey}>
      {match.isGroupLanding ? (
        <GroupLanding locale={locale} group={match.item} />
      ) : (
        <PageHeader locale={locale} titleKey={match.item.seo.titleKey} descriptionKey={match.item.seo.descriptionKey} />
      )}
    </PageLayout>
  )}
</AppLayout>
