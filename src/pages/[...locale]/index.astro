---
import DesignSystemPage from "@/components/design-system/DesignSystemPage.astro";
import AssetViewerPage from "@/components/tools/AssetViewerPage.astro";
import ChartPreview3DPage from "@/components/tools/ChartPreview3DPage.astro";
import Live2DViewerPage from "@/components/tools/Live2DViewerPage.astro";
import StoryPlayerPage from "@/components/tools/StoryPlayerPage.astro";
import MusicRankingPage from "@/components/tools/MusicRankingPage.astro";
import ChartDataPage from "@/components/tools/ChartDataPage.astro";
import CardsPage from "@/components/cards/CardsPage.astro";
import CardDetailPage from "@/components/cards/CardDetailPage.astro";
import SupportCardsPage from "@/components/support-cards/SupportCardsPage.astro";
import SupportCardDetailPage from "@/components/support-cards/SupportCardDetailPage.astro";
import CharactersPage from "@/components/characters/CharactersPage.astro";
import CharacterDetailPage from "@/components/characters/CharacterDetailPage.astro";
import AboutPage from "@/components/about/AboutPage.astro";
import OpenPlatformPage from "@/components/account/OpenPlatformPage.astro";
import OpenPlatformDocsPage from "@/components/account/OpenPlatformDocsPage.astro";
import AccountPage from "@/components/account/AccountPage.astro";
import PlayerPage from "@/components/account/PlayerPage.astro";
import NewsPage from "@/components/news/NewsPage.astro";
import NewsDetailPage from "@/components/news/NewsDetailPage.astro";
import EventTrackerPage from "@/components/events/EventTrackerPage.astro";
import HomePage from "@/components/home/HomePage.astro";
import MusicPage from "@/components/music/MusicPage.astro";
import MusicDetailPage from "@/components/music/MusicDetailPage.astro";
import StampsPage from "@/components/stamps/StampsPage.astro";
import ComicsPage from "@/components/comics/ComicsPage.astro";
import ItemsPage from "@/components/items/ItemsPage.astro";
import BandItemsPage from "@/components/band-items/BandItemsPage.astro";
import GachaPage from "@/components/gacha/GachaPage.astro";
import GachaDetailPage from "@/components/gacha/GachaDetailPage.astro";
import ExchangePage from "@/components/exchange/ExchangePage.astro";
import ExchangeDetailPage from "@/components/exchange/ExchangeDetailPage.astro";
import RewardsPage from "@/components/rewards/RewardsPage.astro";
import RewardDetailPage from "@/components/rewards/RewardDetailPage.astro";
import EventsPage from "@/components/events/EventsPage.astro";
import EventDetailPage from "@/components/events/EventDetailPage.astro";
import TitlesPage from "@/components/titles/TitlesPage.astro";
import BackgroundsPage from "@/components/backgrounds/BackgroundsPage.astro";
import StoryPage from "@/components/story/StoryPage.astro";
import StoryDetailPage from "@/components/story/StoryDetailPage.astro";
import SearchPage from "@/components/search/SearchPage";
import ItemDetailPage from "@/components/items/ItemDetailPage.astro";
import ShopPage from "@/components/shop/ShopPage.astro";
import ShopDetailPage from "@/components/shop/ShopDetailPage.astro";
import MissionsPage from "@/components/missions/MissionsPage.astro";
import TgwCardPage from "@/components/tgw-card/TgwCardPage.astro";
import RealLivesPage from "@/components/real-lives/RealLivesPage.astro";
import BirthdayStoryPage from "@/components/story/BirthdayStoryPage.astro";
import HelpPage from "@/components/help/HelpPage.astro";
import HelpDetailPage from "@/components/help/HelpDetailPage.astro";
import PlaylistsPage from "@/components/music/PlaylistsPage.astro";
import CalendarPage from "@/components/calendar/CalendarPage.astro";
import LegalPage, { type LegalDocument } from "@/components/legal/LegalPage.astro";
import GroupLanding from "@/components/route/GroupLanding.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { DEFAULT_LOCALE, PATH_PREFIX_LOCALE, type AppLocale } from "@/config/locales";
import { findRouteMatch } from "@/lib/route/registry";
import { getStaticLocalizedPaths, type StaticLocalizedPathProps } from "@/lib/route/static-paths";
import { stripLocaleFromPathname } from "@/i18n/routing";

export async function getStaticPaths() {
  return await getStaticLocalizedPaths();
}

const props = Astro.props as Partial<StaticLocalizedPathProps>;
const raw = Astro.params.locale ?? "";
const segments = raw.split("/").filter(Boolean);
const maybeLocale = PATH_PREFIX_LOCALE[segments[0] ?? ""];
const locale: AppLocale = props.locale ?? maybeLocale ?? DEFAULT_LOCALE;
const routePath = maybeLocale ? `/${segments.slice(1).join("/")}` : `/${segments.join("/")}`;
const pathname = props.pathname ?? (routePath === "/" ? "/" : stripLocaleFromPathname(routePath));
const match = props.match ?? findRouteMatch(pathname);

if (!match) {
  return Astro.redirect(locale === DEFAULT_LOCALE ? "/" : `/${segments[0]}`);
}

const component = match.item.component ?? "page";
---

<AppLayout locale={locale} pathname={pathname} meta={props.meta} breadcrumbDetail={props.breadcrumbDetail}>
  {component === "home" ? (
    <HomePage locale={locale} />
  ) : component === "about" ? (
    <AboutPage locale={locale} />
  ) : component === "cards" ? (

    <CardsPage locale={locale} />
  ) : component === "card-detail" ? (
    <CardDetailPage locale={locale} cardId={Number(match.params.id)} />
  ) : component === "support-cards" ? (
    <SupportCardsPage locale={locale} />
  ) : component === "support-card-detail" ? (
    <SupportCardDetailPage locale={locale} supportCardId={Number(match.params.id)} />
  ) : component === "music" ? (
    <MusicPage locale={locale} />
  ) : component === "song-detail" ? (
    <MusicDetailPage locale={locale} songId={Number(match.params.id)} />
  ) : component === "stamps" ? (
    <StampsPage locale={locale} />
  ) : component === "comics" ? (
    <ComicsPage locale={locale} />
  ) : component === "items" ? (
    <ItemsPage locale={locale} />
  ) : component === "band-items" ? (
    <BandItemsPage locale={locale} />
  ) : component === "gacha" ? (
    <GachaPage locale={locale} />
  ) : component === "gacha-detail" ? (
    <GachaDetailPage locale={locale} gachaId={Number(match.params.id)} />
  ) : component === "exchange" ? (
    <ExchangePage locale={locale} />
  ) : component === "exchange-detail" ? (
    <ExchangeDetailPage locale={locale} exchangeId={Number(match.params.id)} />
  ) : component === "rewards" ? (
    <RewardsPage locale={locale} />
  ) : component === "reward-detail" ? (
    <RewardDetailPage locale={locale} slug={match.params.id ?? ""} />
  ) : component === "event-list" ? (
    <EventsPage locale={locale} />
  ) : component === "event-detail" ? (
    <EventDetailPage locale={locale} eventId={Number(match.params.id)} />
  ) : component === "titles" ? (
    <TitlesPage locale={locale} />
  ) : component === "backgrounds" ? (
    <BackgroundsPage locale={locale} />
  ) : component === "story-main" ? (
    <StoryPage locale={locale} category="main" titleKey={match.item.seo.titleKey} descriptionKey={match.item.seo.descriptionKey} />
  ) : component === "story-event" ? (
    <StoryPage locale={locale} category="event" titleKey={match.item.seo.titleKey} descriptionKey={match.item.seo.descriptionKey} />
  ) : component === "story-friendship" ? (
    <StoryPage locale={locale} category="friendship" titleKey={match.item.seo.titleKey} descriptionKey={match.item.seo.descriptionKey} />
  ) : component === "story-other" ? (
    <StoryPage locale={locale} category="other" titleKey={match.item.seo.titleKey} descriptionKey={match.item.seo.descriptionKey} />
  ) : component === "story-detail" ? (
    <StoryDetailPage locale={locale} advId={Number(match.params.id)} />
  ) : component === "characters" ? (
    <CharactersPage locale={locale} />
  ) : component === "character-detail" ? (
    <CharacterDetailPage locale={locale} characterId={Number(match.params.id)} />
  ) : component === "search" ? (
    <PageLayout locale={locale} titleKey={match.item.seo.titleKey} descriptionKey={match.item.seo.descriptionKey}>
      <SearchPage client:visible locale={locale} />
    </PageLayout>
  ) : component === "design-system" ? (
    <DesignSystemPage locale={locale} />
  ) : component === "asset-viewer" ? (
    <AssetViewerPage locale={locale} />
  ) : component === "chart-preview" ? (
    <ChartPreview3DPage locale={locale} />
  ) : component === "live2d-viewer" ? (
    <Live2DViewerPage locale={locale} />
  ) : component === "story-player" ? (
    <StoryPlayerPage locale={locale} />
  ) : component === "music-ranking" ? (
    <MusicRankingPage locale={locale} />
  ) : component === "chart-data" ? (
    <ChartDataPage locale={locale} />
  ) : component === "open-platform" ? (
    <OpenPlatformPage locale={locale} />
  ) : component === "open-platform-docs" ? (
    <OpenPlatformDocsPage locale={locale} />
  ) : component === "account" ? (
    <AccountPage locale={locale} />
  ) : component === "player" ? (
    <PlayerPage locale={locale} />
  ) : component === "news" ? (
    <NewsPage locale={locale} />
  ) : component === "news-detail" ? (
    <NewsDetailPage locale={locale} />
  ) : component === "event-tracker" ? (
    <EventTrackerPage locale={locale} />
  ) : component === "item-detail" ? (
    <ItemDetailPage locale={locale} itemId={Number(match.params.id)} />
  ) : component === "shop" ? (
    <ShopPage locale={locale} />
  ) : component === "shop-detail" ? (
    <ShopDetailPage locale={locale} shopId={Number(match.params.id)} />
  ) : component === "missions" ? (
    <MissionsPage locale={locale} />
  ) : component === "tgw-card" ? (
    <TgwCardPage locale={locale} />
  ) : component === "real-lives" ? (
    <RealLivesPage locale={locale} />
  ) : component === "story-birthday" ? (
    <BirthdayStoryPage locale={locale} />
  ) : component === "help" ? (
    <HelpPage locale={locale} />
  ) : component === "help-detail" ? (
    <HelpDetailPage locale={locale} helpId={Number(match.params.id)} />
  ) : component === "playlists" ? (
    <PlaylistsPage locale={locale} />
  ) : component === "calendar" ? (
    <CalendarPage locale={locale} />
  ) : component === "legal" ? (
    <LegalPage locale={locale} document={match.item.id as LegalDocument} />
  ) : (
    <PageLayout locale={locale} titleKey={match.item.seo.titleKey} descriptionKey={match.item.seo.descriptionKey}>
      {match.isGroupLanding && <GroupLanding locale={locale} group={match.item} />}
    </PageLayout>
  )}
</AppLayout>
