---
import AppLayout from "@/layouts/AppLayout.astro";
import { t } from "@/i18n";
import { siteConfig } from "@/config/site";

const locale = "zh-CN" as const;
const pathname = "/404";
const copy = {
  metaTitle: t(locale, "notFound.metaTitle"),
  metaDescription: t(locale, "notFound.description"),
  eyebrow: "LOST SIGNAL / 404",
  title: t(locale, "notFound.title"),
  description: t(locale, "notFound.description"),
  note: t(locale, "notFound.note"),
  home: t(locale, "notFound.home"),
  retry: t(locale, "actions.refresh"),
  feedback: t(locale, "notFound.feedback"),
};
---

<AppLayout
  locale={locale}
  pathname={pathname}
  meta={{ title: copy.metaTitle, description: copy.metaDescription, indexable: false }}
>
  <section class="mx-auto flex min-h-[62vh] max-w-5xl items-center justify-center py-8 sm:py-14">
    <div class="relative w-full overflow-hidden rounded-[2rem] border border-[var(--mn-border)] bg-[var(--mn-paper)] px-6 py-10 shadow-[var(--mn-shadow-stamp)] sm:px-12 sm:py-14">
      <div class="mn-texture-stars pointer-events-none absolute inset-0 opacity-25"></div>

      <div class="relative grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <div class="order-2 lg:order-1">
          <span class="mn-stamp inline-flex rounded-xl px-4 py-1.5 text-xs tracking-[0.18em]">
            {copy.eyebrow}
          </span>
          <h1 class="mt-7 max-w-3xl font-[var(--mn-font-display)] text-4xl leading-tight text-[var(--mn-text)] sm:text-6xl">
            {copy.title}
          </h1>
          <p class="mt-6 max-w-2xl text-base font-semibold leading-8 text-[var(--mn-text-muted)] sm:text-lg">
            {copy.description}
          </p>

          <div class="mt-7 max-w-2xl rounded-2xl border border-solid border-[var(--mn-border)] bg-[var(--mn-cream-deep)] p-4 text-sm font-medium leading-7 text-[var(--mn-text-muted)]">
            {copy.note}
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/"
              class="mn-focus mn-stamp-press inline-flex items-center justify-center rounded-xl border border-[var(--mn-border)] bg-[var(--mn-accent-deep)] px-6 py-3 text-sm font-bold text-[var(--mn-bg)] shadow-[var(--mn-shadow-stamp)]"
            >
              {copy.home}
            </a>
            <button
              type="button"
              onclick="window.location.reload()"
              class="mn-focus mn-stamp-press inline-flex items-center justify-center rounded-xl border border-[var(--mn-border)] bg-[var(--mn-paper)] px-6 py-3 text-sm font-bold text-[var(--mn-text)] shadow-[var(--mn-shadow-stamp-sm)]"
            >
              {copy.retry}
            </button>
            <a
              href={siteConfig.contact.bugReportUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mn-focus mn-stamp-press inline-flex items-center justify-center rounded-xl border border-[var(--mn-border)] bg-[var(--mn-accent-soft)] px-6 py-3 text-sm font-bold text-[var(--mn-text)] shadow-[var(--mn-shadow-stamp-sm)]"
            >
              {copy.feedback}
            </a>
          </div>
        </div>

        <div class="mx-auto w-full max-w-48 lg:max-w-[15rem] order-1 lg:order-2" aria-hidden="true">
          <div class="relative rounded-[2rem] border border-[var(--mn-border)] bg-[var(--mn-cream-deep)] p-6 shadow-[var(--mn-shadow-stamp)] transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[var(--mn-shadow-stamp-lg)]">
            <svg viewBox="0 0 260 260" class="h-auto w-full" fill="none">
              <circle cx="130" cy="130" r="78" stroke="var(--mn-border)" stroke-dasharray="3 9" />
              <ellipse cx="130" cy="130" rx="116" ry="45" transform="rotate(-35 130 130)" stroke="var(--mn-accent)" />
              <path d="m130 55 14 61 61 14-61 14-14 61-14-61-61-14 61-14z" fill="var(--mn-accent-soft)" stroke="var(--mn-accent)" />
              <circle cx="220" cy="74" r="6" fill="var(--mn-pink)" />
            </svg>
            <p class="mt-3 text-center font-[var(--mn-font-note)] text-5xl font-bold text-[var(--mn-accent-deep)]">404</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</AppLayout>
