---
import "@fontsource-variable/roboto-flex/wght.css";
import "@/styles/global.css";
import Md3ThemeVars from "@/components/md3/Md3ThemeVars.astro";
import BrowserNotice from "@/components/shell/BrowserNotice.astro";
import PageUpdateNotice from "@/components/shell/PageUpdateNotice.astro";
import { HTML_LANG, DEFAULT_LOCALE, OG_LOCALE, type AppLocale } from "@/config/locales";
import { siteConfig } from "@/config/site";
import {
  isGoogleAnalyticsEnabled,
  googleAnalyticsScriptSrc,
  analyticsConfig,
} from "@/config/analytics";
import { localizePath } from "@/i18n/routing";
import { getNavigationGroupId, findRouteMatch } from "@/lib/route/registry";
import { buildNavGroupBootstrapScript, buildThemeBootstrapScript } from "@/lib/settings/apply-theme";
import { SPOILER_REFERENCE_NOW } from "@/lib/settings/spoiler-reference";
import { buildAccountBootstrapScript } from "@/lib/account/bootstrap";
import { buildFilterBootstrapScript } from "@/lib/filter/bootstrap";
import { buildMediaQueryCompatScript } from "@/lib/browser/media-query-compat";
import { absolutePageUrl, buildHreflang, buildPageMetadata, type PageMetadata } from "@/lib/seo/metadata";
import { breadcrumbJsonLd, serializeJsonLd, websiteJsonLd } from "@/lib/seo/jsonld";
import type { BreadcrumbDetail } from "@/types/route";

interface Props {
  locale: AppLocale;
  pathname: string;
  meta?: Partial<PageMetadata> | undefined;
  breadcrumbDetail?: BreadcrumbDetail | undefined;
}

const { locale, pathname, meta: metaOverrides, breadcrumbDetail } = Astro.props;
const meta = buildPageMetadata(pathname, locale, metaOverrides);
const mediaQueryCompatScript = buildMediaQueryCompatScript();
const themeScript = buildThemeBootstrapScript();
const navGroupScript = buildNavGroupBootstrapScript(getNavigationGroupId(pathname));
const accountScript = buildAccountBootstrapScript();
const filterScript = buildFilterBootstrapScript(Boolean(findRouteMatch(pathname)?.item.filterTitleKey));
const website = websiteJsonLd(locale);
const breadcrumbs = breadcrumbJsonLd(pathname, locale, breadcrumbDetail);
const xDefaultHref = absolutePageUrl(localizePath(pathname, DEFAULT_LOCALE));
const gaMeasurementId = analyticsConfig.googleAnalytics.measurementId;
const gaScriptSrc = googleAnalyticsScriptSrc;
const googleAnalyticsBootstrapScript = isGoogleAnalyticsEnabled
  ? `window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\ngtag('config', '${gaMeasurementId}');`
  : "";
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-locale={locale} data-spoiler-now={SPOILER_REFERENCE_NOW}>
  <head>
    <meta charset="utf-8" />
    <!-- Cascade layer order, before any stylesheet: MUI (Emotion) styles sit between Tailwind's base and utilities. -->
    <style is:inline>@layer theme, base, mui, components, utilities;</style>
    <Md3ThemeVars />
    <meta name="color-scheme" content="light dark" />
    <!--
      These three scripts must run before the first paint. `data-cfasync="false"` keeps Cloudflare Rocket Loader from
      rewriting and deferring them: without it the theme, the folded groups and the drawer's scroll offset are applied
      hundreds of milliseconds after the server markup has already painted.
    -->
    <!-- Install the legacy WebView listener bridge before shared stores or MUI islands can load. -->
    <script is:inline data-cfasync="false" set:html={mediaQueryCompatScript}></script>
    <!-- Resolve the theme before any external stylesheet can block this script. -->
    <script is:inline data-cfasync="false" set:html={themeScript}></script>
    <!-- Hide the stored folds in the server markup before the first paint (the drawer itself stays visible). -->
    <script is:inline data-cfasync="false" set:html={navGroupScript}></script>
    <!-- Drop the drawer's account row before the first paint when this deployment has no account API. -->
    <script is:inline data-cfasync="false" set:html={accountScript}></script>
    <!-- Apply a filter sheet left open, before the first paint: the content's width and the filter button. -->
    {filterScript && <script is:inline data-cfasync="false" set:html={filterScript}></script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.fullTitle}</title>
    <meta name="description" content={meta.description} />
    {meta.keywords.length > 0 && <meta name="keywords" content={meta.keywords.join(", ")} />}
    <meta
      name="robots"
      content={meta.indexable
        ? "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
        : "noindex,follow"}
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={meta.canonical} />
    {meta.alternates.map((alt) => <link rel="alternate" hreflang={buildHreflang(alt.locale)} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={meta.fullTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    {meta.alternates
      .filter((alt) => alt.locale !== locale)
      .map((alt) => <meta property="og:locale:alternate" content={OG_LOCALE[alt.locale]} />)}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={meta.image} />
    <meta property="og:image:alt" content={meta.fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.fullTitle} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image} />
    <meta name="twitter:image:alt" content={meta.fullTitle} />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(website)}></script>
    {breadcrumbs && <script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbs)}></script>}
    {isGoogleAnalyticsEnabled && (
      <>
        {analyticsConfig.googleAnalytics.domains.map((domain) => (
          <link rel="preconnect" href={domain} />
        ))}
        <script is:inline async src={gaScriptSrc}></script>
        <script is:inline set:html={googleAnalyticsBootstrapScript}></script>
      </>
    )}
  </head>
  <body>
    <BrowserNotice locale={locale} />
    <PageUpdateNotice locale={locale} />
    <slot />
  </body>
</html>
