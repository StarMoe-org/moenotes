{$SITE_ADDRESS} {
    root * /srv
    # Includes application/wasm: the chart renderer module is ~22 MB raw, ~8 MB compressed.
    encode zstd gzip

    # Vite/Astro output under /_astro/ is content-hashed, so a new build never reuses a URL.
    header /_astro/* Cache-Control "public, max-age=31536000, immutable"

    try_files {path} {path}/index.html {path}.html
    file_server

    handle_errors {
        @not_found expression {err.status_code} == 404
        rewrite @not_found /404.html
        file_server
    }
}
